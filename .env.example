# Server-only Neon Postgres connection (pooled URL)
DATABASE_URL=
# Direct connection for migrations (Neon CLI pulls this automatically)
DATABASE_URL_UNPOOLED=
# Neon managed authentication; configure email/password and password reset email
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# The approved owner's Neon Auth user ID, not their email
ADMIN_USER_ID=
# ImageKit upload and delivery settings
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
# Public origin (no trailing slash); use your Netlify/custom domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional WhatsApp number for the local demo; actual shop number is saved in settings
SHOP_WHATSAPP=+233208987183

# Temporary sample catalogue, only while the real products table is empty
SHOW_SAMPLE_PRODUCTS=false
